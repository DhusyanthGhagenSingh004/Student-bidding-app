# ── Server environment variables ──
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

PORT=5000
NODE_ENV=development

# Supabase PostgreSQL connection string
# Find it in: Supabase Dashboard → Connect → Session Pooler → URI
# Example format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=replace_with_supabase_connection_string
